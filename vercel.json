{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/readyz",
      "destination": "/api"
    },
    {
      "source": "/memory/:path*",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    }
  ]
}
