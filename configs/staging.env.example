# ==============================================================================
# Staging Environment Configuration
# Google Photos — AI Memory Context MVP
# ==============================================================================

NODE_ENV=staging
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=https://staging-photos.google.com

GCP_PROJECT_ID=google-photos-memory-staging
GCP_REGION=us-central1

SPANNER_INSTANCE_ID=memory-spanner-staging
SPANNER_DATABASE_ID=memory_db
SPANNER_MAX_POOL_SIZE=50

REDIS_HOST=10.0.0.15
REDIS_PORT=6379
REDIS_KEY_PREFIX=gphotos:mem:staging:

GEMINI_MODEL=gemini-1.5-flash-001
GEMINI_FALLBACK_MODEL=gemini-1.5-pro-001
VERTEX_VECTOR_INDEX_ID=projects/google-photos-memory-staging/locations/us-central1/indexes/staging-index
VERTEX_VECTOR_ENDPOINT_ID=projects/google-photos-memory-staging/locations/us-central1/indexEndpoints/staging-endpoint
EMBEDDING_MODEL=text-embedding-005

CLOUD_TASKS_QUEUE_NAME=memory-processing-queue-staging
WORKER_WEBHOOK_URL=https://staging-worker.photos-memory.googleapis.com/internal/tasks/process-memory

PROMPT_COOLDOWN_DAYS=14
MAX_WEEKLY_PROMPTS=3
ENABLE_SENSITIVE_DLP_SCAN=true
ENABLE_VOICE_TRANSCRIPTION=true
