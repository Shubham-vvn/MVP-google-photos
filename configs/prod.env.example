# ==============================================================================
# Production Environment Configuration
# Google Photos — AI Memory Context MVP
# ==============================================================================

NODE_ENV=production
PORT=8080
LOG_LEVEL=warn
CORS_ORIGIN=https://photos.google.com

GCP_PROJECT_ID=google-photos-memory-prod
GCP_REGION=us-central1

SPANNER_INSTANCE_ID=memory-spanner-prod
SPANNER_DATABASE_ID=memory_db
SPANNER_MAX_POOL_SIZE=200

REDIS_HOST=10.128.0.22
REDIS_PORT=6379
REDIS_KEY_PREFIX=gphotos:mem:prod:

GEMINI_MODEL=gemini-1.5-flash-001
GEMINI_FALLBACK_MODEL=gemini-1.5-pro-001
VERTEX_VECTOR_INDEX_ID=projects/google-photos-memory-prod/locations/us-central1/indexes/prod-index
VERTEX_VECTOR_ENDPOINT_ID=projects/google-photos-memory-prod/locations/us-central1/indexEndpoints/prod-endpoint
EMBEDDING_MODEL=text-embedding-005

CLOUD_TASKS_QUEUE_NAME=memory-processing-queue-prod
WORKER_WEBHOOK_URL=https://worker.photos-memory.googleapis.com/internal/tasks/process-memory

PROMPT_COOLDOWN_DAYS=14
MAX_WEEKLY_PROMPTS=3
ENABLE_SENSITIVE_DLP_SCAN=true
ENABLE_VOICE_TRANSCRIPTION=true
