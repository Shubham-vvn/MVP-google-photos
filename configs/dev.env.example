# ==============================================================================
# Development Environment Configuration
# Google Photos — AI Memory Context MVP
# ==============================================================================

# Server & Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Google Cloud Project & Region
GCP_PROJECT_ID=google-photos-memory-mvp-dev
GCP_REGION=us-central1

# Cloud Spanner
SPANNER_INSTANCE_ID=memory-spanner-dev
SPANNER_DATABASE_ID=memory_db
SPANNER_MAX_POOL_SIZE=10

# Redis Memorystore (Local or Dev Endpoint)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_KEY_PREFIX=gphotos:mem:dev:

# Vertex AI & Gemini Configuration
GEMINI_MODEL=gemini-1.5-flash-001
GEMINI_FALLBACK_MODEL=gemini-1.5-pro-001
GEMINI_API_KEY=dummy-dev-api-key-or-use-adc
VERTEX_VECTOR_INDEX_ID=dev-matching-engine-index-001
VERTEX_VECTOR_ENDPOINT_ID=dev-matching-engine-endpoint-001
EMBEDDING_MODEL=text-embedding-005

# Cloud Tasks Async Queue
CLOUD_TASKS_QUEUE_NAME=memory-processing-queue-dev
WORKER_WEBHOOK_URL=http://localhost:8080/internal/tasks/process-memory

# Rate Limits & Feature Controls
PROMPT_COOLDOWN_DAYS=14
MAX_WEEKLY_PROMPTS=3
ENABLE_SENSITIVE_DLP_SCAN=true
ENABLE_VOICE_TRANSCRIPTION=true
